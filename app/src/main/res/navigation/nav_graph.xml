<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mb_programming_work.home.HomeFragment"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.mb_programming_work.payment.PaymentFragment"
        android:label="PaymentFragment" >
        <argument
            android:name="selectedCar"
            app:argType="com.example.mb_programming_work.home.Car"
            app:nullable="false" />
        <action
            android:id="@+id/action_paymentFragment_to_paymentResultFragment"
            app:destination="@id/paymentResultFragment"
            app:popUpTo="@id/paymentFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:id="@+id/paymentResultFragment"
        android:name="com.example.mb_programming_work.payment_result.PaymentResultFragment"
        android:label="PaymentResultFragment" >
        <action
            android:id="@+id/action_paymentResultFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>